# ============================================
# ENVIRONMENT VARIABLES FOR LENSIQUE
# ============================================
# Copy this file to .env and fill in the values.
# For Vercel: add these in Project Settings > Environment Variables.

# MySQL Database Connection
# On Vercel, use your managed MySQL provider (PlanetScale, Railway, Aiven, etc.)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=lensique

# Set to "true" if your MySQL provider requires SSL (e.g., PlanetScale, Railway)
DB_SSL=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=24h

# Server Port (only used on localhost; Vercel ignores this)
PORT=3000

# Node Environment (set to "production" on Vercel)
NODE_ENV=development
